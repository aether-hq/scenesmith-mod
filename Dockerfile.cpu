# CPU-only runtime for the complete SceneSmith pipeline.
#
# Build on Apple silicon with:
#   docker build --platform linux/amd64 -f Dockerfile.cpu -t aether-scenesmith-cpu .
#
# Drake publishes a Linux x86_64 wheel but no Apple-silicon wheel. Running this
# image through Docker therefore keeps every SceneSmith stage available without
# requiring CUDA or silently substituting a partial pipeline.
FROM --platform=linux/amd64 python:3.11-slim-bookworm AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    bubblewrap \
    build-essential \
    cmake \
    git \
    git-lfs \
    libegl1 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxi6 \
    libxkbcommon0 \
    libxrender1 \
    libxxf86vm1 \
    ninja-build \
    unzip \
    wget \
    && rm -rf /var/lib/apt/lists/*

ENV UV_HTTP_TIMEOUT=600

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock .python-version README.md ./
RUN uv sync --frozen --no-dev

COPY . .

ENV VIRTUAL_ENV=/app/.venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV CUDA_VISIBLE_DEVICES=""

CMD ["python", "-c", "import bpy, pydrake, scenesmith; print('full SceneSmith CPU runtime ready')"]
